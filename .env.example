# ── Core ────────────────────────────────────────────────────────────────────────────────
# Public origin of the site (used for CORS/CSRF, links in emails, sitemap).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional extra trusted origins for CORS/CSRF, comma-separated (e.g. http://localhost:3000 when
# NEXT_PUBLIC_SERVER_URL is a tunnel URL).
ALLOWED_ORIGINS=
# Random, >= 32 chars. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# ── Database (SQLite / libSQL) ──────────────────────────────────────────────────────────
# Local / VPS:  file:./data/payload.db
# Netlify:      libsql://<db>-<org>.turso.io   (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/payload.db
DATABASE_AUTH_TOKEN=

# ── First-user bootstrap ────────────────────────────────────────────────────────────────
# Used ONLY when the users table is empty: creates one super_admin who must change the
# password at first login. Remove these after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ── File storage ────────────────────────────────────────────────────────────────────────
# Leave S3_BUCKET empty on a VPS / local dev: files are stored on disk under ./data.
# Set it on Netlify/Vercel (Cloudflare R2 or any S3-compatible bucket). The bucket must be PRIVATE:
# files are served through Payload so resumes and job descriptions stay access-checked.
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
